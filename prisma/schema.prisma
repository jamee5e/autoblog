generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
}

enum WebsiteStatus {
  ACTIVE
  INACTIVE
}

enum ArticleStatus {
  DRAFT
  RESEARCHING
  WRITING
  CHECKING
  REVISION
  READY
  PUBLISHING
  PUBLISHED
  FAILED
}

enum AIRunProvider {
  GEMINI
  ANTHROPIC
  OPENAI
  OTHER
}

enum AIAgentType {
  RESEARCH
  WRITER
  QUALITY
  ORCHESTRATOR
}

enum AIRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum NotificationType {
  READY_FOR_REVIEW
  PUBLISHED
  ERROR
}

enum NotificationChannel {
  LINE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum SystemLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum ScheduledJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ScheduledJobAction {
  GENERATE_ONLY
  GENERATE_AND_DRAFT
}

enum ScheduledContentSource {
  MANUAL
  TOPIC_FOCUS_AUTO
  TOPIC_FOCUS_SELECTED
}

enum InternalLinkSource {
  MANUAL
  WORDPRESS
}

model Company {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")

  users         User[]
  websites      Website[]
  scheduledJobs ScheduledJob[]

  @@map("companies")
}

model User {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scheduledJobs ScheduledJob[]

  @@index([companyId])
  @@map("users")
}

model Website {
  id                                   String        @id @default(cuid())
  companyId                            String        @map("company_id")
  name                                 String
  wordpressUrl                         String        @map("wordpress_url")
  wordpressUsername                    String        @map("wordpress_username")
  wordpressApplicationPasswordEncrypted String       @map("wordpress_application_password_encrypted")
  defaultAuthor                        String?       @map("default_author")
  defaultCategory                      String?       @map("default_category")
  status                               WebsiteStatus @default(ACTIVE)
  createdAt                            DateTime      @default(now()) @map("created_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brandProfiles BrandProfile[]
  articles      Article[]
  scheduledJobs ScheduledJob[]
  topicFocuses   BlogTopicFocus[]
  internalLinks  InternalLink[]

  @@index([companyId])
  @@map("websites")
}

model BrandProfile {
  id              String   @id @default(cuid())
  websiteId       String   @map("website_id")
  language        String
  tone            String
  targetAudience  String   @map("target_audience")
  brandPrompt     String   @map("brand_prompt")
  seoRules        Json?    @map("seo_rules")
  prohibitedTerms Json?    @map("prohibited_terms")
  defaultCta      String?  @map("default_cta")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, language])
  @@index([websiteId])
  @@map("brand_profiles")
}

model Article {
  id              String        @id @default(cuid())
  websiteId        String        @map("website_id")
  topic           String
  primaryKeyword  String        @map("primary_keyword")
  additionalInstructions String? @map("additional_instructions")
  researchData    Json?          @map("research_data")
  qualityData     Json?          @map("quality_data")
  qualityScore    Int?           @map("quality_score")
  revisionCount   Int            @default(0) @map("revision_count")
  title           String?
  slug            String?
  metaDescription String?       @map("meta_description")
  ctaData         Json?          @map("cta_data")
  excerpt         String?
  content         String?
  status          ArticleStatus @default(DRAFT)
  seoScore        Int?          @map("seo_score")
  wordpressPostId String?       @map("wordpress_post_id")
  wordpressUrl    String?       @map("wordpress_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  publishedAt     DateTime?     @map("published_at")

  website       Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  aiRuns        AIRun[]
  notifications Notification[]
  scheduledJob  ScheduledJob?
  internalLinks ArticleInternalLink[]

  @@index([websiteId])
  @@index([status])
  @@index([createdAt])
  @@map("articles")
}

model AIRun {
  id            String        @id @default(cuid())
  articleId     String        @map("article_id")
  provider      AIRunProvider
  agentType     AIAgentType   @map("agent_type")
  model         String
  status        AIRunStatus
  inputTokens   Int?          @map("input_tokens")
  outputTokens  Int?          @map("output_tokens")
  estimatedCost Decimal?      @map("estimated_cost") @db.Decimal(12, 6)
  errorMessage  String?       @map("error_message")
  startedAt     DateTime      @default(now()) @map("started_at")
  completedAt   DateTime?     @map("completed_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([status])
  @@map("ai_runs")
}

model Notification {
  id        String             @id @default(cuid())
  articleId String             @map("article_id")
  type      NotificationType
  channel   NotificationChannel
  status    NotificationStatus @default(PENDING)
  sentAt    DateTime?          @map("sent_at")
  createdAt DateTime           @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([status])
  @@map("notifications")
}

model SystemLog {
  id        String         @id @default(cuid())
  level     SystemLogLevel
  module    String
  message   String
  metadata  Json?
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([level])
  @@index([createdAt])
  @@map("system_logs")
}


model ScheduledJob {
  id                     String             @id @default(cuid())
  companyId              String             @map("company_id")
  websiteId              String             @map("website_id")
  createdById            String             @map("created_by_id")
  articleId              String?            @unique @map("article_id")
  contentSource          ScheduledContentSource @default(MANUAL) @map("content_source")
  topicFocusId           String?                @map("topic_focus_id")
  topic                   String?
  primaryKeyword          String?                @map("primary_keyword")
  additionalInstructions String?                @map("additional_instructions")
  scheduledAt            DateTime               @map("scheduled_at")
  timezone               String                 @default("Asia/Bangkok")
  action                 ScheduledJobAction     @default(GENERATE_AND_DRAFT)
  status                 ScheduledJobStatus @default(PENDING)
  lastError              String?            @map("last_error")
  startedAt              DateTime?          @map("started_at")
  completedAt            DateTime?          @map("completed_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  article    Article?        @relation(fields: [articleId], references: [id], onDelete: SetNull)
  topicFocus BlogTopicFocus? @relation(fields: [topicFocusId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([websiteId])
  @@index([topicFocusId])
  @@index([status, scheduledAt])
  @@map("scheduled_jobs")
}


model BlogTopicFocus {
  id          String    @id @default(cuid())
  websiteId   String    @map("website_id")
  title       String
  focusTopic  String    @map("focus_topic")
  keywords    String[]  @default([])
  angle       String?
  priority    Int       @default(5)
  active      Boolean   @default(true)
  startDate   DateTime? @db.Date @map("start_date")
  endDate     DateTime? @db.Date @map("end_date")
  notes       String?
  lastUsedAt  DateTime? @map("last_used_at")
  useCount    Int       @default(0) @map("use_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  website       Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  scheduledJobs ScheduledJob[]

  @@index([websiteId])
  @@index([active])
  @@index([startDate, endDate])
  @@map("blog_topic_focus")
}


model InternalLink {
  id                  String             @id @default(cuid())
  websiteId           String             @map("website_id")
  pageTitle           String             @map("page_title")
  url                 String
  targetKeywords      String[]           @default([]) @map("target_keywords")
  anchorSuggestions   String[]           @default([]) @map("anchor_suggestions")
  contentType         String?            @map("content_type")
  priority            Int                @default(5)
  active              Boolean            @default(true)
  source              InternalLinkSource @default(MANUAL)
  wordpressObjectId   Int?               @map("wordpress_object_id")
  wordpressObjectType String?            @map("wordpress_object_type")
  useCount            Int                @default(0) @map("use_count")
  lastUsedAt          DateTime?          @map("last_used_at")
  lastSyncedAt        DateTime?          @map("last_synced_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  website      Website               @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  articleLinks ArticleInternalLink[]

  @@unique([websiteId, url])
  @@index([websiteId])
  @@index([active])
  @@index([source])
  @@map("internal_links")
}

model ArticleInternalLink {
  id             String   @id @default(cuid())
  articleId      String   @map("article_id")
  internalLinkId String   @map("internal_link_id")
  anchorText     String?  @map("anchor_text")
  createdAt      DateTime @default(now()) @map("created_at")

  article      Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  internalLink InternalLink @relation(fields: [internalLinkId], references: [id], onDelete: Cascade)

  @@unique([articleId, internalLinkId])
  @@index([articleId])
  @@index([internalLinkId])
  @@map("article_internal_links")
}
